# === CREDENCIALES SOMA (copiar a .env y llenar) ===

# Brevo API (envío de correos vía HTTPS 443 — Render no alcanza SMTP)
# Verificar remitente info@soma-arquitectura.com en Brevo → Settings → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-tu_api_key

# Supabase (base de datos PostgreSQL vía pooler)
SUPABASE_URL=postgresql://postgres.usuario:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Cloudflare Workers (deploy keep-warm)
CLOUDFLARE_API_TOKEN=tu_token_workers
CLOUDFLARE_ACCOUNT_ID=tu_account_id

# Twilio WhatsApp
TWILIO_SID=tu_twilio_sid
TWILIO_TOKEN=tu_twilio_token
NOTIFICACION_WHATSAPP=+5219995314093
